{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDF View",
  "version": "0.1.0",
  "identifier": "com.pdfview.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDF View",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python-ocr/ocr_engine.py": "python-ocr/ocr_engine.py",
      "../python-ocr/requirements.txt": "python-ocr/requirements.txt",
      "../python-ocr/README.md": "python-ocr/README.md"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
